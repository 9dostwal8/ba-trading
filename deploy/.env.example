# ---------------------------------------------------------------------------
# OfferDent — self-hosting environment variables
# Copy to .env at the project root and fill in your own values.
# ---------------------------------------------------------------------------

# --- Database / backend (Supabase project you control) ---------------------
# Client-visible (safe to ship in the browser bundle)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Server-only (never expose to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Web push (generate your own VAPID pair, see README.deploy.md) --------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# --- QiCard payment gateway (get from QiCard merchant onboarding) ---------
QI_API_HOST=https://uat-sandbox-3ds-api.qi.iq
QI_TERMINAL_ID=
QI_USERNAME=
QI_PASSWORD=
QI_WEBHOOK_PUBLIC_KEY=

# --- AI product listing (optional) ---------------------------------------
# On Lovable this is the AI Gateway key. Self-hosted: point the code in
# src/lib/ai-listing.server.ts at your own Gemini/OpenAI endpoint + key.
LOVABLE_API_KEY=

# --- Google Maps reverse geocoding (address auto-fill) -------------------
GOOGLE_MAPS_API_KEY=
